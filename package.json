{
  "name": "tilaya-bot",
  "version": "1.0.0",
  "description": "Telegram TempMail Private Bot",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "PATH=\"/usr/local/bin:$PATH\" node --watch src/index.js",
    "start": "PATH=\"/usr/local/bin:$PATH\" node src/index.js",
    "build": "PATH=\"/usr/local/bin:$PATH\" node --check src/index.js",
    "test": "PATH=\"/usr/local/bin:$PATH\" node --test 'tests/**/*.test.js'",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0"
  }
}

